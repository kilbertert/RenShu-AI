# 应用监听
APP_HOST=0.0.0.0
APP_PORT=8094
APP_RELOAD=false

# 调试开关（医疗对话可能包含隐私，默认禁止记录完整 LLM 请求体）
LLM_HTTP_DEBUG=false

# 前端跨域白名单（英文逗号分隔）；生产环境填写实际 HTTPS 域名，不要使用 *
CORS_ALLOW_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# 前端开发服务器把同源 /api 代理到后端，避免远程浏览器访问 localhost。
VITE_DEV_API_TARGET=http://127.0.0.1:8094
# 生产部署可显式填写完整 API 地址；留空时前端使用当前主机的 8094 端口。
VITE_API_BASE_URL=
VITE_API_PORT=8094

# 首个管理员引导默认关闭。仅在空库初始化时临时启用，并配置强随机令牌。
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_TOKEN=

# LangGraph 多轮状态持久化（生产及真实联调建议保持 true）
USE_POSTGRES_CHECKPOINTER=true
CHECKPOINTER_POOL_MIN_SIZE=1
CHECKPOINTER_POOL_MAX_SIZE=10

# JWT 与敏感数据加密：部署前必须替换为随机值
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
# 下面仅是开发环境示例；生产环境请生成新的 Fernet key
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL（与 docker-compose.yml 的开发配置一致）
POSTGRESQL_DATABASE_NAME=tcm_agent_db
POSTGRESQL_ASYNC_DRIVER=asyncpg
POSTGRESQL_SYNC_DRIVER=psycopg2
POSTGRESQL_USER_NAME=postgres
POSTGRESQL_PASSWORD=replace-with-a-database-password
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5434
POSTGRESQL_POOL_SIZE=20
POSTGRESQL_MAX_OVERFLOW=40
POSTGRESQL_POOL_RECYCLE=3600
POSTGRESQL_POOL_TIMEOUT=300
POSTGRESQL_ECHO=false

# Redis
REDIS_URL=redis://localhost:6390/0
REDIS_ENABLED=true

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-neo4j-password
NEO4J_DB=neo4j

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6335
QDRANT_COLLECTION=tcm_memories

# 大模型与检索服务（按需填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
SERPER_API_KEY=

# Optional isolated provider smoke tests. Never commit a real key here.
TEST_LLM_API_KEY=
TEST_LLM_BASE_URL=
